# Kopia tohto suboru ako .env a dopln tajomstva.
# Skutocny .env sa nikdy necommituje. Na vytvorenie .env s nahodnym tajomstvom pouzi: bash scripts/make_env.sh

# Aplikacia
APP_NAME=KOMPAS
APP_ENV=development
APP_PORT=8000

# Rozsah rocnikov (technicka predvolena hodnota, docasna - kym pouzivatel nerozhodne)
GRADE_MIN=1
GRADE_MAX=9

# Databaza (SQLite pre vyvoj/testy, PostgreSQL pre produkciu)
DATABASE_URL=sqlite:///./.data/kompas.db

# JWT (HS256, PyJWT) - tajomstvo MUSI byt nastavene v .env, bez predvolenej hodnoty
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Analyticke centrum
ANALYTICS_MIN_GROUP_SIZE=5
