# Kopia tohto suboru ako .env a dopln tajomstva.
# Skutocny .env sa nikdy necommituje. Na vytvorenie .env s nahodnym tajomstvom pouzi: bash scripts/make_env.sh

# Aplikacia
APP_NAME=KOMPAS
APP_ENV=development
APP_PORT=8000

# Rozsah rocnikov (technicka predvolena hodnota, docasna - kym pouzivatel nerozhodne)
GRADE_MIN=1
GRADE_MAX=9

# Databaza (SQLite pre vyvoj/testy, PostgreSQL pre produkciu)
DATABASE_URL=sqlite:///./.data/kompas.db

# JWT (HS256, PyJWT) - tajomstvo MUSI byt nastavene v .env, bez predvolenej hodnoty
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=kompas
JWT_AUDIENCE=kompas-api

# Rate limiting a zamknutie uctu po neuspesnych prihlaseniach
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_DEFAULT_PER_MINUTE=120
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# AI rezim: iba deterministicky NullProvider, ziadne externe volania
AI_PROVIDER=null
AI_EXTERNAL_ENABLED=false

# Analyticke centrum
ANALYTICS_MIN_GROUP_SIZE=5
